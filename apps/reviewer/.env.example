# One set of these per instance, in that instance's Vercel project.
# See docs/deploy-an-instance.md. Secrets are marked; never commit real values.

# --- Identity --------------------------------------------------------------
# `<org>` for a per-org instance (the default), `<org>-<repo>` for a per-repo instance.
PRBOT_INSTANCE_ID=acme
PRBOT_GITHUB_OWNER=acme
# `*` reviews every repo the GitHub App is installed on in the owner; or a comma list: api,web
PRBOT_GITHUB_REPOS=*
# The GitHub App slug people @mention, without the @.
PRBOT_GITHUB_BOT_NAME=acme-reviewer
# Optional: defaults to github/prbot-<instance id>. Set to share one App across instances.
# PRBOT_GITHUB_CONNECTOR=github/prbot-acme
# Optional: defaults to PRBOT_GITHUB_CONNECTOR.
# PRBOT_GITHUB_TOOLS_CONNECTOR=github/prbot-acme

# --- Review policy ---------------------------------------------------------
# never | hitl (a maintainer confirms each approval) | auto
PRBOT_APPROVE_MODE=hitl
PRBOT_MAINTAINER_ROLES=maintain,admin

# --- Memory (one Upstash database per instance) ----------------------------
PRBOT_MEMORY_BACKEND=agentkit
PRBOT_MEMORY_ORG_SLOT=true
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=            # secret

# --- Wiki (pick one) --------------------------------------------------------
PRBOT_WIKI_PROVIDER=linear           # none | linear | confluence

# Linear: a read-only API key from the workspace this instance reviews.
PRBOT_LINEAR_TEAMS=ENG
LINEAR_API_KEY=                      # secret

# Confluence: an Atlassian API token (API token auth must be enabled for the Rovo MCP server).
# PRBOT_CONFLUENCE_SPACES=ENG,ARCH
# PRBOT_CONFLUENCE_CLOUD_ID=          # optional; pins cloudId so the model can't pick another site
# ATLASSIAN_EMAIL=reviewer-bot@acme.dev
# ATLASSIAN_API_TOKEN=                # secret
